{
  "name": "maremovals",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/prisma/build/index.js generate && node ./node_modules/next/dist/bin/next build",
    "vercel-build": "node ./node_modules/prisma/build/index.js generate && node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node --import tsx --test tests/canonical-pricing.test.ts",
    "postinstall": "node ./node_modules/prisma/build/index.js generate",
    "seed:items": "node ./node_modules/tsx/dist/cli.mjs prisma/seed-items.ts",
    "item-metrics:v2:generate": "node ./scripts/generate-item-metrics-v2.mjs",
    "item-metrics:v2:backfill": "node ./node_modules/tsx/dist/cli.mjs scripts/backfill-item-metrics-v2.ts --dry-run"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@chakra-ui/react": "^3.34.0",
    "@emotion/react": "^11.14.0",
    "@mapbox/mapbox-gl-geocoder": "^5.1.2",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@react-pdf/renderer": "^4.5.1",
    "@stripe/react-stripe-js": "^6.2.0",
    "@stripe/stripe-js": "^9.2.0",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "mapbox-gl": "^3.22.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "pusher": "^5.3.3",
    "pusher-js": "^8.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.2",
    "slugify": "^1.6.9",
    "stripe": "^22.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
